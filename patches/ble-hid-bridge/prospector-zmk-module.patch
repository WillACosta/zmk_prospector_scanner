diff --git a/src/ble_hid_bridge.c b/src/ble_hid_bridge.c
new file mode 100644
index 0000000..27d36bf
--- /dev/null
+++ b/src/ble_hid_bridge.c
@@ -0,0 +1,513 @@
+/* SPDX-License-Identifier: MIT */
+
+#include <string.h>
+#include <zephyr/bluetooth/bluetooth.h>
+#include <zephyr/bluetooth/conn.h>
+#include <zephyr/bluetooth/gatt.h>
+#include <zephyr/bluetooth/hci.h>
+#include <zephyr/init.h>
+#include <zephyr/kernel.h>
+#include <zephyr/logging/log.h>
+#include <zephyr/usb/usb_device.h>
+#include <prospector/ble_hid_bridge.h>
+#include <zmk/hid.h>
+#include <zmk/pointing/resolution_multipliers.h>
+#include <zmk/usb.h>
+#include <zmk/usb_hid.h>
+
+LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
+
+#define BRIDGE_PAIR_WINDOW_MS 60000
+#define HOGP_INPUT_REPORT 1
+#define HOGP_FEATURE_REPORT 3
+
+enum {
+    REPORT_KEYBOARD,
+    REPORT_CONSUMER,
+    REPORT_MOUSE,
+    REPORT_MOUSE_FEATURE,
+    REPORT_COUNT,
+};
+
+static const struct {
+    uint8_t id;
+    uint8_t type;
+    uint8_t size;
+} report_formats[REPORT_COUNT] = {
+    [REPORT_KEYBOARD] = {ZMK_HID_REPORT_ID_KEYBOARD, HOGP_INPUT_REPORT,
+                         sizeof(struct zmk_hid_keyboard_report_body)},
+    [REPORT_CONSUMER] = {ZMK_HID_REPORT_ID_CONSUMER, HOGP_INPUT_REPORT,
+                         sizeof(struct zmk_hid_consumer_report_body)},
+    [REPORT_MOUSE] = {ZMK_HID_REPORT_ID_MOUSE, HOGP_INPUT_REPORT,
+                      sizeof(struct zmk_hid_mouse_report_body)},
+    [REPORT_MOUSE_FEATURE] = {ZMK_HID_REPORT_ID_MOUSE, HOGP_FEATURE_REPORT,
+                              sizeof(struct zmk_hid_mouse_resolution_feature_report_body)},
+};
+
+struct bridge_report {
+    atomic_val_t generation;
+    uint8_t index;
+    union {
+        struct zmk_hid_keyboard_report_body keyboard;
+        struct zmk_hid_consumer_report_body consumer;
+        struct zmk_hid_mouse_report_body mouse;
+    } body;
+};
+
+K_MSGQ_DEFINE(bridge_reports, sizeof(struct bridge_report), 48, 4);
+static atomic_t release_pending;
+static atomic_t report_generation;
+static atomic_t link_busy;
+static int64_t pairing_deadline;
+static bt_addr_le_t candidate;
+
+struct discovery_state {
+    uint16_t service_end;
+    uint16_t map_handle;
+    uint16_t map_read;
+    struct {
+        uint16_t value;
+        uint16_t end;
+    } reports[REPORT_COUNT];
+    uint8_t report_count;
+    uint8_t next_report;
+    uint16_t ccc_handle;
+    uint16_t reference_handle;
+    uint16_t mouse_feature;
+    uint8_t received;
+};
+
+static struct discovery_state hids;
+static struct bt_gatt_discover_params discover_params;
+static struct bt_gatt_read_params read_params;
+static struct bt_gatt_exchange_params mtu_params;
+static struct bt_gatt_subscribe_params subscriptions[REPORT_MOUSE_FEATURE];
+
+static struct k_spinlock connection_lock;
+static struct bt_conn *connected_peer;
+
+static int send_usb_report(const struct bridge_report *report) {
+    switch (report->index) {
+    case REPORT_KEYBOARD:
+        zmk_hid_get_keyboard_report()->body = report->body.keyboard;
+        return zmk_usb_hid_send_keyboard_report();
+    case REPORT_CONSUMER:
+        zmk_hid_get_consumer_report()->body = report->body.consumer;
+        return zmk_usb_hid_send_consumer_report();
+    case REPORT_MOUSE:
+        zmk_hid_get_mouse_report()->body = report->body.mouse;
+        return zmk_usb_hid_send_mouse_report();
+    default:
+        return -EINVAL;
+    }
+}
+
+static bool usb_can_write(void) {
+    return zmk_usb_is_hid_ready() && zmk_usb_get_status() != USB_DC_SUSPEND;
+}
+
+static void request_release(void) {
+    atomic_inc(&report_generation);
+    k_msgq_purge(&bridge_reports);
+    atomic_set(&release_pending, 1);
+}
+
+static void sync_mouse_resolution(void) {
+    static atomic_val_t last_generation = -1;
+    static uint8_t last_value;
+    const struct zmk_endpoint_instance usb = {.transport = ZMK_TRANSPORT_USB};
+    const struct zmk_pointing_resolution_multipliers m =
+        zmk_pointing_resolution_multipliers_get_profile(usb);
+    const struct zmk_hid_mouse_resolution_feature_report_body feature = {
+        .wheel_res = m.wheel, .hwheel_res = m.hor_wheel,
+    };
+    uint8_t value;
+    memcpy(&value, &feature, sizeof(value));
+
+    k_spinlock_key_t key = k_spin_lock(&connection_lock);
+    const uint16_t handle = hids.mouse_feature;
+    const atomic_val_t generation = atomic_get(&report_generation);
+    struct bt_conn *conn = NULL;
+    if (connected_peer && handle && (value != last_value || generation != last_generation)) {
+        conn = bt_conn_ref(connected_peer);
+    }
+    k_spin_unlock(&connection_lock, key);
+
+    if (conn) {
+        if (!bt_gatt_write_without_response(conn, handle, &value, sizeof(value), false)) {
+            last_generation = generation;
+            last_value = value;
+        }
+        bt_conn_unref(conn);
+    }
+}
+
+static void usb_forward(void *unused1, void *unused2, void *unused3) {
+    while (true) {
+        struct bridge_report report;
+        int result = k_msgq_get(&bridge_reports, &report, K_MSEC(10));
+
+        if (usb_can_write() && atomic_cas(&release_pending, 1, 0)) {
+            for (uint8_t index = 0; index < REPORT_MOUSE_FEATURE; index++) {
+                const struct bridge_report neutral = {.index = index};
+                if (send_usb_report(&neutral)) {
+                    atomic_set(&release_pending, 1);
+                    break;
+                }
+            }
+        }
+
+        if (!result && usb_can_write() && !atomic_get(&release_pending) &&
+            report.generation == atomic_get(&report_generation) && send_usb_report(&report)) {
+            request_release();
+        }
+        sync_mouse_resolution();
+    }
+}
+
+K_THREAD_DEFINE(prospector_usb_bridge, 2048, usb_forward, NULL, NULL, NULL, 5, 0, 0);
+
+static void reject_peer(struct bt_conn *conn, const char *reason) {
+    LOG_WRN("Prospector HID bridge: %s", reason);
+    bt_conn_disconnect(conn, BT_HCI_ERR_REMOTE_USER_TERM_CONN);
+}
+
+static uint8_t report_notification(struct bt_conn *conn, struct bt_gatt_subscribe_params *params,
+                                   const void *data, uint16_t length) {
+    if (!data) {
+        return BT_GATT_ITER_STOP;
+    }
+
+    size_t index = params - subscriptions;
+    if (index >= ARRAY_SIZE(subscriptions) || length != report_formats[index].size) {
+        reject_peer(conn, "Unexpected HID input report length");
+        return BT_GATT_ITER_STOP;
+    }
+
+    if (!zmk_usb_is_hid_ready()) {
+        return BT_GATT_ITER_CONTINUE;
+    }
+    if (zmk_usb_get_status() == USB_DC_SUSPEND) {
+        usb_wakeup_request();
+        return BT_GATT_ITER_CONTINUE;
+    }
+
+    struct bridge_report report = {
+        .generation = atomic_get(&report_generation), .index = index,
+    };
+    memcpy(&report.body, data, length);
+    if (k_msgq_put(&bridge_reports, &report, K_NO_WAIT)) {
+        request_release();
+        reject_peer(conn, "USB report queue overrun");
+    }
+    return BT_GATT_ITER_CONTINUE;
+}
+
+static void subscription_finished(struct bt_conn *conn, uint8_t err,
+                                  struct bt_gatt_subscribe_params *params) {
+    if (err) {
+        reject_peer(conn, "HOGP notification subscription failed");
+    }
+}
+
+static uint8_t discover_descriptor(struct bt_conn *conn, const struct bt_gatt_attr *attr,
+                                   struct bt_gatt_discover_params *params);
+static void discover_next_report(struct bt_conn *conn);
+
+static uint8_t read_report_reference(struct bt_conn *conn, uint8_t err,
+                                     struct bt_gatt_read_params *params, const void *data,
+                                     uint16_t length) {
+    if (err || !data || length != 2) {
+        reject_peer(conn, "Cannot read HOGP report reference");
+        return BT_GATT_ITER_STOP;
+    }
+
+    const uint8_t *ref = data;
+    for (uint8_t index = 0; index < REPORT_COUNT; index++) {
+        if (ref[0] != report_formats[index].id || ref[1] != report_formats[index].type) {
+            continue;
+        }
+        if (hids.received & BIT(index)) {
+            reject_peer(conn, "Duplicate HOGP report reference");
+            return BT_GATT_ITER_STOP;
+        }
+        hids.received |= BIT(index);
+        const uint16_t value_handle = hids.reports[hids.next_report - 1].value;
+        if (index == REPORT_MOUSE_FEATURE) {
+            k_spinlock_key_t key = k_spin_lock(&connection_lock);
+            hids.mouse_feature = value_handle;
+            k_spin_unlock(&connection_lock, key);
+            discover_next_report(conn);
+            return BT_GATT_ITER_STOP;
+        }
+        if (!hids.ccc_handle) {
+            reject_peer(conn, "HOGP report has no notification descriptor");
+            return BT_GATT_ITER_STOP;
+        }
+
+        struct bt_gatt_subscribe_params *sub = &subscriptions[index];
+        sub->notify = report_notification;
+        sub->subscribe = subscription_finished;
+        sub->value = BT_GATT_CCC_NOTIFY;
+        sub->value_handle = value_handle;
+        sub->ccc_handle = hids.ccc_handle;
+        sub->min_security = BT_SECURITY_L2;
+        atomic_set_bit(sub->flags, BT_GATT_SUBSCRIBE_FLAG_VOLATILE);
+        if (bt_gatt_subscribe(conn, sub)) {
+            reject_peer(conn, "Cannot subscribe to HOGP input reports");
+            return BT_GATT_ITER_STOP;
+        }
+        break;
+    }
+
+    discover_next_report(conn);
+    return BT_GATT_ITER_STOP;
+}
+
+static uint8_t discover_descriptor(struct bt_conn *conn, const struct bt_gatt_attr *attr,
+                                   struct bt_gatt_discover_params *params) {
+    if (attr) {
+        if (!bt_uuid_cmp(attr->uuid, BT_UUID_GATT_CCC)) {
+            hids.ccc_handle = attr->handle;
+        } else if (!bt_uuid_cmp(attr->uuid, BT_UUID_HIDS_REPORT_REF)) {
+            hids.reference_handle = attr->handle;
+        }
+        return BT_GATT_ITER_CONTINUE;
+    }
+
+    read_params = (struct bt_gatt_read_params){
+        .func = read_report_reference, .handle_count = 1,
+        .single.handle = hids.reference_handle,
+    };
+    if (!hids.reference_handle || bt_gatt_read(conn, &read_params)) {
+        reject_peer(conn, "Missing HOGP report reference");
+    }
+    return BT_GATT_ITER_STOP;
+}
+
+static void discover_next_report(struct bt_conn *conn) {
+    if (hids.next_report == hids.report_count) {
+        if (hids.received != BIT_MASK(REPORT_COUNT)) {
+            reject_peer(conn, "Missing keyboard, consumer, pointer or resolution report");
+        } else {
+            LOG_INF("Prospector HID bridge connected");
+        }
+        return;
+    }
+
+    uint8_t index = hids.next_report++;
+    hids.ccc_handle = 0;
+    hids.reference_handle = 0;
+    discover_params = (struct bt_gatt_discover_params){
+        .type = BT_GATT_DISCOVER_DESCRIPTOR, .func = discover_descriptor,
+        .start_handle = hids.reports[index].value + 1,
+        .end_handle = hids.reports[index].end,
+    };
+    if (bt_gatt_discover(conn, &discover_params)) {
+        reject_peer(conn, "Cannot discover HOGP report descriptors");
+    }
+}
+
+static uint8_t compare_report_map(struct bt_conn *conn, uint8_t err,
+                                  struct bt_gatt_read_params *params, const void *data,
+                                  uint16_t length) {
+    if (err) {
+        reject_peer(conn, "Cannot read HOGP report map");
+        return BT_GATT_ITER_STOP;
+    }
+    if (data) {
+        if (hids.map_read + length > sizeof(zmk_hid_report_desc) ||
+            memcmp(data, &zmk_hid_report_desc[hids.map_read], length)) {
+            reject_peer(conn, "Corne and Prospector HID report maps differ");
+            return BT_GATT_ITER_STOP;
+        }
+        hids.map_read += length;
+        return BT_GATT_ITER_CONTINUE;
+    }
+    if (hids.map_read != sizeof(zmk_hid_report_desc)) {
+        reject_peer(conn, "Incomplete HOGP report map");
+    } else {
+        discover_next_report(conn);
+    }
+    return BT_GATT_ITER_STOP;
+}
+
+static uint8_t discover_characteristic(struct bt_conn *conn, const struct bt_gatt_attr *attr,
+                                       struct bt_gatt_discover_params *params) {
+    if (!attr) {
+        read_params = (struct bt_gatt_read_params){
+            .func = compare_report_map, .handle_count = 1, .single.handle = hids.map_handle,
+        };
+        if (!hids.map_handle || bt_gatt_read(conn, &read_params)) {
+            reject_peer(conn, "Missing HOGP report map");
+        }
+        return BT_GATT_ITER_STOP;
+    }
+
+    /* Close the preceding report's descriptor range at the next declaration. */
+    if (hids.report_count && hids.reports[hids.report_count - 1].end == hids.service_end) {
+        hids.reports[hids.report_count - 1].end = attr->handle - 1;
+    }
+    const struct bt_gatt_chrc *chrc = attr->user_data;
+    if (!bt_uuid_cmp(chrc->uuid, BT_UUID_HIDS_REPORT_MAP)) {
+        hids.map_handle = chrc->value_handle;
+    } else if (!bt_uuid_cmp(chrc->uuid, BT_UUID_HIDS_REPORT)) {
+        if (hids.report_count == ARRAY_SIZE(hids.reports)) {
+            reject_peer(conn, "Unexpected HOGP report layout");
+            return BT_GATT_ITER_STOP;
+        }
+        hids.reports[hids.report_count].value = chrc->value_handle;
+        hids.reports[hids.report_count++].end = hids.service_end;
+    }
+    return BT_GATT_ITER_CONTINUE;
+}
+
+static uint8_t discover_service(struct bt_conn *conn, const struct bt_gatt_attr *attr,
+                                struct bt_gatt_discover_params *params) {
+    if (!attr) {
+        reject_peer(conn, "No HID service");
+        return BT_GATT_ITER_STOP;
+    }
+
+    const struct bt_gatt_service_val *service = attr->user_data;
+    hids.service_end = service->end_handle;
+    discover_params = (struct bt_gatt_discover_params){
+        .type = BT_GATT_DISCOVER_CHARACTERISTIC, .func = discover_characteristic,
+        .start_handle = attr->handle + 1, .end_handle = hids.service_end,
+    };
+    if (bt_gatt_discover(conn, &discover_params)) {
+        reject_peer(conn, "Cannot discover HID characteristics");
+    }
+    return BT_GATT_ITER_STOP;
+}
+
+static void mtu_exchanged(struct bt_conn *conn, uint8_t err,
+                          struct bt_gatt_exchange_params *params) {
+    if (err || bt_gatt_get_mtu(conn) < sizeof(struct zmk_hid_keyboard_report_body) + 3) {
+        reject_peer(conn, "ATT MTU is too small for Corne NKRO reports");
+        return;
+    }
+
+    discover_params = (struct bt_gatt_discover_params){
+        .type = BT_GATT_DISCOVER_PRIMARY, .uuid = BT_UUID_HIDS, .func = discover_service,
+        .start_handle = BT_ATT_FIRST_ATTRIBUTE_HANDLE, .end_handle = BT_ATT_LAST_ATTRIBUTE_HANDLE,
+    };
+    if (bt_gatt_discover(conn, &discover_params)) {
+        reject_peer(conn, "Cannot discover HID service");
+    }
+}
+
+static void security_changed(struct bt_conn *conn, bt_security_t level, enum bt_security_err err) {
+    if (err || level < BT_SECURITY_L2) {
+        reject_peer(conn, "Secure BLE connection failed");
+        return;
+    }
+
+    if (mtu_params.func) {
+        return;
+    }
+    mtu_params.func = mtu_exchanged;
+    int error = bt_gatt_exchange_mtu(conn, &mtu_params);
+    if (error == -EALREADY) {
+        mtu_exchanged(conn, 0, &mtu_params);
+    } else if (error) {
+        reject_peer(conn, "Cannot exchange ATT MTU");
+    }
+}
+
+static void connected(struct bt_conn *conn, uint8_t err) {
+    if (err) {
+        LOG_WRN("Prospector BLE connection failed (0x%02x)", err);
+        atomic_clear(&link_busy);
+        return;
+    }
+
+    memset(subscriptions, 0, sizeof(subscriptions));
+    memset(&mtu_params, 0, sizeof(mtu_params));
+    k_spinlock_key_t key = k_spin_lock(&connection_lock);
+    memset(&hids, 0, sizeof(hids));
+    connected_peer = bt_conn_ref(conn);
+    k_spin_unlock(&connection_lock, key);
+
+    if (bt_conn_set_security(conn, BT_SECURITY_L2)) {
+        reject_peer(conn, "Cannot start BLE encryption");
+    } else if (bt_conn_get_security(conn) >= BT_SECURITY_L2) {
+        security_changed(conn, bt_conn_get_security(conn), 0);
+    }
+}
+
+static void disconnected(struct bt_conn *conn, uint8_t reason) {
+    k_spinlock_key_t key = k_spin_lock(&connection_lock);
+    struct bt_conn *previous = connected_peer;
+    connected_peer = NULL;
+    hids.mouse_feature = 0;
+    k_spin_unlock(&connection_lock, key);
+    if (previous) {
+        bt_conn_unref(previous);
+    }
+
+    request_release();
+    atomic_clear(&link_busy);
+}
+
+BT_CONN_CB_DEFINE(bridge_callbacks) = {
+    .connected = connected,
+    .disconnected = disconnected,
+    .security_changed = security_changed,
+};
+
+struct bond_match {
+    const bt_addr_le_t *address;
+    bool has_bond;
+    bool matches;
+};
+
+static void find_bond(const struct bt_bond_info *info, void *user_data) {
+    struct bond_match *match = user_data;
+    match->has_bond = true;
+    match->matches |= bt_addr_le_cmp(&info->addr, match->address) == 0;
+}
+
+static void connect_to_candidate(struct k_work *work) {
+    struct bt_conn *conn = NULL;
+    /* The previous connection's ATT requests and volatile subscriptions have been removed
+     * by Zephyr before it returns its only connection slot to the pool. */
+    int err = bt_conn_le_create(&candidate, BT_CONN_LE_CREATE_CONN,
+                                BT_LE_CONN_PARAM(12, 18, 0, 400), &conn);
+    if (err) {
+        atomic_clear(&link_busy);
+    } else {
+        bt_conn_unref(conn);
+    }
+}
+
+static K_WORK_DELAYABLE_DEFINE(connect_work, connect_to_candidate);
+
+void prospector_bridge_advertisement(const bt_addr_le_t *addr, const char *name) {
+    if (atomic_get(&link_busy) || !zmk_usb_is_hid_ready()) {
+        return;
+    }
+
+    struct bond_match match = {.address = addr};
+    bt_foreach_bond(BT_ID_DEFAULT, find_bond, &match);
+    if (match.has_bond ? !match.matches
+                       : (k_uptime_get() >= pairing_deadline ||
+                          strcmp(name, CONFIG_PROSPECTOR_BLE_HID_BRIDGE_NAME))) {
+        return;
+    }
+    if (atomic_cas(&link_busy, 0, 1)) {
+        bt_addr_le_copy(&candidate, addr);
+        k_work_schedule(&connect_work, K_MSEC(250));
+    }
+}
+
+static int bridge_init(void) {
+    int err = bt_enable(NULL);
+    if (err && err != -EALREADY) {
+        return err;
+    }
+    pairing_deadline = k_uptime_get() + BRIDGE_PAIR_WINDOW_MS;
+    return 0;
+}
+
+SYS_INIT(bridge_init, APPLICATION, 80);
