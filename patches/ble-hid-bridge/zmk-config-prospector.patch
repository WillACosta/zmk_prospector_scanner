diff --git a/config/prospector_ble_bridge.conf b/config/prospector_ble_bridge.conf
new file mode 100644
index 0000000..95831b1
--- /dev/null
+++ b/config/prospector_ble_bridge.conf
@@ -0,0 +1,22 @@
+# The scanner shares one BLE connection with the Corne; ZMK handles USB output.
+CONFIG_ZMK_BLE=n
+CONFIG_ZMK_USB=y
+CONFIG_BT_CENTRAL=y
+CONFIG_BT_EXT_ADV=y
+CONFIG_BT_SCAN_AND_INITIATE_IN_PARALLEL=y
+CONFIG_BT_GATT_CLIENT=y
+CONFIG_BT_SMP=y
+CONFIG_BT_SMP_SC_PAIR_ONLY=y
+CONFIG_BT_SETTINGS=y
+CONFIG_SETTINGS=y
+CONFIG_BT_MAX_CONN=1
+CONFIG_BT_MAX_PAIRED=1
+CONFIG_BT_L2CAP_TX_MTU=65
+CONFIG_BT_BUF_ACL_RX_SIZE=69
+
+# Match the Corne's report descriptor. The bridge verifies the map over GATT.
+CONFIG_ZMK_HID_REPORT_TYPE_NKRO=y
+CONFIG_ZMK_HID_CONSUMER_REPORT_USAGES_FULL=y
+CONFIG_ZMK_POINTING=y
+CONFIG_ZMK_POINTING_SMOOTH_SCROLLING=y
+CONFIG_PROSPECTOR_BLE_HID_BRIDGE=y
